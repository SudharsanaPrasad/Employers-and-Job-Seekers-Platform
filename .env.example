# Environment variables. Set these locally or in the hosting dashboard.
# Never commit real values - only this template is committed.

# --- Backend ---
# MongoDB Atlas connection string, with the database name in the path
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careernest_db
MONGODB_DATABASE=careernest_db

# a long random secret (at least 32 characters) used to sign JWTs
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Twilio SMS (optional). Leave blank to disable SMS (messages are only logged);
# set all three to send real texts. Store phone numbers in E.164, e.g. +9198XXXXXXXX.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Frontend (Vite) ---
# base URL of the backend API the React app talks to
VITE_API_BASE_URL=http://localhost:8080
