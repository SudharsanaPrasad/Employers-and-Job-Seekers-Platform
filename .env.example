# sample file. copy it and put the real values, do not commit the real ones

# backend
# mongodb connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careernest_db
MONGODB_DATABASE=careernest_db

# secret key for jwt, use a long random text
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# twilio keys, keep empty if you don't want to send real sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# frontend
# backend api url
VITE_API_BASE_URL=http://localhost:8080
